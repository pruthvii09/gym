# Django
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://gymstreak:gymstreak@db:5432/gymstreak

# Redis / Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (Resend, prod only -- dev prints emails to stdout automatically)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@gymstreak.local

# Base URL of the Next.js frontend -- used to build links in outbound
# emails (e.g. gym staff invites) and in push notification deep links
FRONTEND_URL=http://localhost:3000

# Web Push (VAPID) -- generate with `vapid --gen` (from the pywebpush
# package). Leave blank in dev to skip push delivery.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@gymstreak.local

# CORS (comma-separated list of allowed origins, empty = nothing allowed)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security (prod only; safe defaults are derived from DJANGO_DEBUG otherwise)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Postgres (used by the docker-compose db service itself)
POSTGRES_DB=gymstreak
POSTGRES_USER=gymstreak
POSTGRES_PASSWORD=gymstreak

# Superuser bootstrap for local dev only (leave blank to skip)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
