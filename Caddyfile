# Single public entrypoint for the whole app -- the browser only ever talks
# to this (port 443/80). It routes API/admin/static requests to Django and
# everything else to Next.js, so nothing else needs to be exposed to the
# internet. Caddy automatically provisions and renews a Let's Encrypt
# certificate for this domain -- no manual cert management needed.

{
	email contact.pruthvirajauti@gmail.com
}

gym.roast.baby {
	handle /api/* {
		reverse_proxy web:8000
	}

	handle /admin/* {
		reverse_proxy web:8000
	}

	handle /static/* {
		reverse_proxy web:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
