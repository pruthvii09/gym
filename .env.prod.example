# Copy this to `.env` on the server (next to docker-compose.prod.yml) and
# fill in real values. Never commit the real `.env` -- it holds secrets.

# --- Images pulled by docker-compose.prod.yml (CI builds and pushes these
# on every push to main) -- replace <owner>/<repo> with your GitHub
# owner/repo, lowercased (GHCR requires lowercase image names). ---
IMAGE_API=ghcr.io/<owner>/<repo>-api:latest
IMAGE_WEB=ghcr.io/<owner>/<repo>-web:latest

# --- Django ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret
DJANGO_DEBUG=False
# Your Elastic IP and/or domain, comma-separated, no scheme (e.g.
# 203.0.113.10,gymstreak.example.com)
DJANGO_ALLOWED_HOSTS=

# --- Database (self-hosted Postgres, same host, not exposed publicly) ---
DATABASE_URL=postgres://gymstreak:gymstreak@db:5432/gymstreak
POSTGRES_DB=gymstreak
POSTGRES_USER=gymstreak
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Redis / Celery (same host, not exposed publicly) ---
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email (Resend -- free tier is fine to start: https://resend.com) ---
# Leave RESEND_API_KEY blank only if you're OK with invite/OTP emails
# failing to send; there's no console fallback once DJANGO_DEBUG=False.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# --- Frontend URL -- used to build links in outbound emails. Same
# host/domain the browser uses to reach the app (Caddy's public address). ---
FRONTEND_URL=http://your-elastic-ip

# --- CORS -- only matters for requests that don't go through Caddy's
# same-origin proxy; safe to leave matching FRONTEND_URL. ---
CORS_ALLOWED_ORIGINS=http://your-elastic-ip

# --- Security -- leave these as-is once you're on HTTPS (a real domain
# through Caddy); if you're running HTTP-only on the bare IP, keep the
# SSL/cookie flags False below or you'll lock yourself out. ---
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- One-time superuser bootstrap (created on first boot if both are set;
# safe to blank out again after) ---
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
